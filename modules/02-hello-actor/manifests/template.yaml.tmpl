# ActorTemplate agent-v1 — a Substrate record (not a Kubernetes object), in the protojson
# shape of ateapipb.ActorTemplate. Applied with `kubectl ate create actor-template -f -`.
# Immutable once created: there is no update, only delete + recreate (see Module 3's agent-v2).
metadata:
  atespace: ${ATESPACE}
  name: agent-v1
# Which workers may run this template's actors: matched against the WorkerPool's own labels
# (workerpool.yaml.tmpl's metadata.labels), not the Kubernetes Pod labels.
workerSelector:
  matchLabels:
    workload: workshop-agent
containers:
- name: agent
  image: ${AGENT_IMAGE}            # must be digest-pinned (@sha256:…); a CEL admission rule enforces this
  command: ["/ko-app/agent"]
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
  volumeMounts:
  - name: data
    mountPath: /data
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 536870912 # 512Mi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY  # suspend: memory + disk
  storageLocation: gs://${BUCKET_NAME}/${ATESPACE}/agent-v1/
volumes:
- name: data
  durableDir: {}                           # per-actor directory that survives suspend/resume
