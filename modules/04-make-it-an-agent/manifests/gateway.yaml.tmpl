# The always-on gateway. Rendered by scripts/gateway.sh.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gateway
  namespace: ${NAMESPACE}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  replicas: 1   # one replica: the idle tracker is in memory
  selector:
    matchLabels: {app: gateway}
  template:
    metadata:
      labels: {app: gateway}
    spec:
      serviceAccountName: gateway
      containers:
      - name: gateway
        image: ${GATEWAY_IMAGE}
        ports:
        - {name: http, containerPort: 8080}
        env:
        - {name: ATESPACE, value: "${ATESPACE}"}
        - {name: MOCK_LLM, value: "${MOCK_LLM}"}
        - {name: GEMINI_MODEL, value: "${GEMINI_MODEL}"}
        - {name: GOOGLE_CLOUD_PROJECT, value: "${PROJECT_ID}"}
        # Read by the Google GenAI SDK: call Gemini on the Gemini platform, at MODEL_LOCATION.
        - {name: GOOGLE_GENAI_USE_ENTERPRISE, value: "true"}
        - {name: GOOGLE_CLOUD_LOCATION, value: "${MODEL_LOCATION}"}
        - {name: IDLE_AFTER, value: "${IDLE_AFTER}"}
        # Where actors reach the gateway: background jobs send heartbeats here (optional lab C).
        - {name: SELF_URL, value: "http://gateway.${NAMESPACE}.svc.cluster.local"}
        readinessProbe:
          httpGet: {path: /readyz, port: http}
        resources:
          requests: {cpu: 100m, memory: 128Mi}
          limits: {memory: 256Mi}
        volumeMounts:
        - {name: ate-token, mountPath: /var/run/ate/token, readOnly: true}
        - {name: ate-trust, mountPath: /var/run/ate/trust, readOnly: true}
        - {name: ate-identity, mountPath: /var/run/ate/identity, readOnly: true}
      volumes:
      # A token ateapi accepts: audience api.ate-system.svc, rotated by the kubelet.
      - name: ate-token
        projected:
          sources:
          - serviceAccountToken:
              audience: api.ate-system.svc
              expirationSeconds: 3600
              path: token
      # The CA that signs ateapi's and atenet-router's serving certificates, published as a ClusterTrustBundle.
      - name: ate-trust
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels: {podcert.ate.dev/canarying: live}
              path: trust-bundle.pem
      # The SPIFFE client certificate (spiffe://cluster.local/ns/${NAMESPACE}/sa/gateway)
      # presented to atenet-router:443 over mTLS.
      - name: ate-identity
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
---
apiVersion: v1
kind: Service
metadata:
  name: gateway
  namespace: ${NAMESPACE}
  labels: {app: gateway}
spec:
  selector: {app: gateway}
  ports:
  - {name: http, port: 80, targetPort: http}
