# ActorTemplate agent-v2: same agent, now keeping its counter on the durableDir.
# Templates are immutable, so a behavior change means a new template version.
metadata:
  atespace: ${ATESPACE}
  name: agent-v2
workerSelector:
  matchLabels:
    workload: workshop-agent
containers:
- name: agent
  image: ${AGENT_IMAGE}
  command: ["/ko-app/agent"]
  readyz:
    httpGet: {path: /readyz, port: 80}
  volumeMounts:
  - {name: data, mountPath: /data}
resources:
  limits:
  - {name: cpu, quantity: "1"}
  - {name: memory, quantity: 512Mi}
snapshotsConfig:
  onPause: SNAPSHOT_CONTENT_SCOPE_FULL
  # Suspend keeps only the durableDir: memory is thrown away, and resume cold-boots the process.
  onCommit: SNAPSHOT_CONTENT_SCOPE_DATA
  onResume:
    fromData: RESUME_SOURCE_COLD_BOOT
  storageLocation: gs://${BUCKET_NAME}/${ATESPACE}/agent-v2/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
volumes:
- name: data
  durableDir: {}
