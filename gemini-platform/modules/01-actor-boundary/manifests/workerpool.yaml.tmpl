apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
  labels:
    ate.dev/api-access: "true"
    ate.dev/gateway-access: "true"
---
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: sre-workers
  namespace: ${NAMESPACE}
  labels:
    workload: sre-agent
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
    - name: gvisor
      configRef:
        name: gvisor-default
  template:
    labels:
      workload: sre-agent
    resources:
      requests:
        cpu: 250m
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 1Gi
