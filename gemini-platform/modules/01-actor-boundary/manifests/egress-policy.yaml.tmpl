# Per-actor default-deny EgressPolicy (ateapipb.EgressPolicy protojson schema).
# Permits outbound HTTP strictly to the Governed Broker (sre-gateway); all other
# cluster services, metadata server endpoints, and public internet hosts remain blocked.
rules:
  - http:
      hostnames:
        - sre-gateway.${NAMESPACE}.svc.cluster.local
      ports:
        numbers: [80, 8080]
