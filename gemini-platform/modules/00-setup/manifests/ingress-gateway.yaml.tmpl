apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
  labels:
    ate.dev/api-access: "true"
    ate.dev/gateway-access: "true"
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: sre-ingress-gateway
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: sre-gateway
spec:
  gatewayClassName: gke-l7-regional-external-managed
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              ate.dev/gateway-access: "true"
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: sre-agent-gateway
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: sre-gateway
spec:
  gatewayClassName: gke-l7-rilb
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Same
---
apiVersion: networking.gke.io/v1
kind: GCPAgentGateway
metadata:
  name: sre-client-to-agent-gateway
  namespace: ${NAMESPACE}
  labels:
    app.kubernetes.io/name: sre-gateway
  annotations:
    agentregistry.googleapis.com/registries: "//agentregistry.googleapis.com/projects/${PROJECT_ID}/locations/global,//agentregistry.googleapis.com/projects/${PROJECT_ID}/locations/${REGION}"
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: sre-agent-gateway
