apiVersion: v1
kind: Namespace
metadata:
  name: ${SIM_NAMESPACE}
  labels:
    ate.dev/gateway-access: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ops-hub
  namespace: ${SIM_NAMESPACE}
automountServiceAccountToken: false
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ledger-api
  namespace: ${SIM_NAMESPACE}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ops-hub
  namespace: ${SIM_NAMESPACE}
  labels:
    app: ops-hub
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ops-hub
  template:
    metadata:
      labels:
        app: ops-hub
    spec:
      serviceAccountName: ops-hub
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ops-hub
          image: ${OPS_HUB_IMAGE}
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          env:
            - name: PORT
              value: "8080"
            - name: DATA_DIR
              value: "/var/lib/opshub"
            - name: SIM_NAMESPACE
              value: "${SIM_NAMESPACE}"
            - name: PUBLIC_GIT_URL
              value: "http://ops-hub.${SIM_NAMESPACE}.svc.cluster.local:8080/git/ledger-api.git"
            - name: LEDGER_API_URL
              value: "http://ledger-api.${SIM_NAMESPACE}.svc.cluster.local:8080"
            - name: OPS_HUB_REQUIRE_3LO
              value: "false"
            - name: OPS_HUB_OAUTH_CLIENT_ID
              value: "sre-gateway-3lo"
            - name: OPS_HUB_OAUTH_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: ops-hub-oauth
                  key: client-secret
                  optional: true
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 250m
              memory: 192Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 2
            periodSeconds: 5
          volumeMounts:
            - name: data
              mountPath: /var/lib/opshub
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: data
          emptyDir: {}
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: ops-hub
  namespace: ${SIM_NAMESPACE}
  labels:
    app: ops-hub
spec:
  selector:
    app: ops-hub
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      protocol: TCP
    - name: http-80
      port: 80
      targetPort: 8080
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ledger-api
  namespace: ${SIM_NAMESPACE}
  labels:
    app: ledger-api
spec:
  replicas: 1
  selector:
    matchLabels:
      app: ledger-api
  template:
    metadata:
      labels:
        app: ledger-api
    spec:
      serviceAccountName: ledger-api
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ledger-api
          image: ${LEDGER_API_IMAGE}
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          env:
            - name: PORT
              value: "8080"
            - name: MAX_OPEN_CONNS
              value: "2"
            - name: IDLE_TIMEOUT_SECONDS
              value: "0"
            - name: ACQUIRE_TIMEOUT_MS
              value: "150"
            - name: LEAK_FIXED
              value: "false"
            - name: SYNTHETIC_LOAD
              value: "true"
            - name: OPS_HUB_CONFIG_URL
              value: "http://ops-hub.${SIM_NAMESPACE}.svc.cluster.local:8080/api/config/pool"
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          livenessProbe:
            httpGet:
              path: /livez
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /livez
              port: 8080
            initialDelaySeconds: 2
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: ledger-api
  namespace: ${SIM_NAMESPACE}
  labels:
    app: ledger-api
spec:
  selector:
    app: ledger-api
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      protocol: TCP
    - name: http-80
      port: 80
      targetPort: 8080
      protocol: TCP
