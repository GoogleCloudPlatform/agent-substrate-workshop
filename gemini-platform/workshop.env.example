# Copy to workshop.env and fill in PROJECT_ID and CLUSTER_LOCATION.
PROJECT_ID=
# Cloud region for the snapshot bucket, Artifact Registry, Model Armor, and regional Agent Gateway.
REGION=us-central1
CLUSTER_NAME=ate-cluster
# Zone or region of your GKE cluster from the LOCATION column of `gcloud container clusters list`.
CLUSTER_LOCATION=
BUCKET_NAME=${PROJECT_ID}-ate
AR_REPO=workshop-301
KO_DOCKER_REPO=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}
KO_DEFAULTPLATFORMS=linux/amd64

# Agent Substrate version and published image location. Leave SUBSTRATE_IMAGE_REPO and
# SUBSTRATE_IMAGE_TAG empty only if building Substrate from source with Docker buildx.
SUBSTRATE_REF=v1.0.0
SUBSTRATE_IMAGE_REPO=ghcr.io/agent-substrate/substrate
SUBSTRATE_IMAGE_TAG=${SUBSTRATE_REF}

# Workshop 301 namespaces. Distinct from 101's `workshop` namespace so both tracks can run on one cluster.
NAMESPACE=workshop-301
ATESPACE=workshop-301
SIM_NAMESPACE=prod-sim

# Gemini platform configuration.
MOCK_LLM=false
GEMINI_MODEL=gemini-3.8-flash
MODEL_LOCATION=global

# Quota-safe ComputeClass toggle: false applies ComputeClass/substrate-gvisor without provisioning extra
# node pools in fixed-quota classrooms; set true to let GKE auto-create c3/n4/n2 pools on demand.
ENABLE_COMPUTE_CLASS_AUTOPROVISION=false

# Optional external GitHub OAuth 2.0 app credentials for Module 05 3LO Auth Manager override.
# Leave empty to use the self-contained Operations Hub OAuth 2.0 + PKCE server in prod-sim.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
