{
  "displayName": "Workshop: actor resume P95 above 5s",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "resume P95 > 5s for 5m",
      "conditionPrometheusQueryLanguage": {
        "query": "histogram_quantile(0.95, sum by (le) (rate({\"ate.actor.lifecycle.operation.duration_bucket\", \"ate.actor.operation.name\"=\"resume\", \"cluster\"=\"${CLUSTER_NAME}\"}[5m]))) > 5",
        "duration": "300s",
        "evaluationInterval": "60s"
      }
    }
  ],
  "documentation": {
    "content": "Resumes are slow. Check snapshot sizes (Snapshot dashboard) and worker CPU.",
    "mimeType": "text/markdown"
  }
}
