# ActorTemplate agent-fetch-v1 (optional lab I): agent-v3 running app/cmd/agent-fetch, plus the egress
# gateway's CA and public roots. The gateway terminates every HTTPS connection allowed by an `https` rule and
# presents a leaf it minted, so the actor must trust the gateway's CA (substrate docs/egress-trust-bundle.md).
# FETCH_IMAGE comes from your shell: FETCH_IMAGE=$(cd app && ko build --base-import-paths ./cmd/agent-fetch)
metadata:
  atespace: ${ATESPACE}
  name: agent-fetch-v1
workerSelector:
  matchLabels:
    workload: workshop-agent
containers:
- name: agent
  image: ${FETCH_IMAGE}
  command: ["/ko-app/agent-fetch"]
  env:
  - name: MODEL_URL
    value: http://gateway.${NAMESPACE}.svc.cluster.local/v1/model
  - name: SSL_CERT_FILE
    value: /run/ate/trust-bundle.pem
  - name: SSL_CERT_DIR
    value: /run/ate
  wakeupProbe:
    httpGet: {path: /readyz, port: 80}
  volumeMounts:
  - {name: data, mountPath: /data}
  - {name: system-info, mountPath: /run/ate}
resources:
  limits:
  - {name: cpu, quantity: "1"}
  - {name: memory, quantity: 512Mi}
snapshotConfig:
  onCommit: SNAPSHOT_CONTENT_SCOPE_FULL
  storageLocation: gs://${BUCKET_NAME}/${ATESPACE}/agent-fetch-v1/
sandboxConfig:
  sandboxClass: SANDBOX_CLASS_GVISOR
  configName: gvisor-default
volumes:
- name: data
  durableDir: {}
- name: system-info
  systemInfo:
    dataSources:
    - trustBundle:
        names:
        - egress-mitm.ate.dev
        - system-roots.ate.dev
        path: trust-bundle.pem
