# Workspace with a shallow Git clone for optional lab B step 5.
# Apply optional/B-ax/egress-github.yaml to repo-task before running `ax resume task repo-task`.
apiVersion: ax.io/v1alpha1
kind: Workspace
metadata:
  name: repo-workspace
  atespace: ax-workshop
spec:
  git:
    - name: env
      repo: "https://github.com/agent-substrate/env.git"
      branch: "main"
      depth: 1
---
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  name: repo-task
  atespace: ax-workshop
spec:
  image: "${RUNNER_IMAGE}"
  debug: true
  workspaces:
    - name: repo-workspace
      path: "/workspace"
