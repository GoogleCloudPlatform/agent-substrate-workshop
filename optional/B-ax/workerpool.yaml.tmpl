# Two generic worker Pods in ax-system for optional lab B (google/ax).
# Any ActorTemplate generated by ax-server selects workload=ax-worker.
apiVersion: v1
kind: Namespace
metadata:
  name: ax-system
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ax-workers
  namespace: ax-system
  labels:
    workload: ax-worker
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
  template:
    labels:
      workload: ax-worker
    nodeSelector:
      ate.dev/substrate-version: "${SUBSTRATE_VERSION}"
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
