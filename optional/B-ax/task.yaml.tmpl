# Declarative Workspace + Task for optional lab B (google/ax).
# RUNNER_IMAGE comes from your shell: RUNNER_IMAGE=$(cd .workshop/ax && ko build --base-import-paths ./cmd/ax-task-runner)
apiVersion: ax.io/v1alpha1
kind: Workspace
metadata:
  name: demo-workspace
  atespace: ax-workshop
spec:
  files:
    - path: "AGENTS.md"
      content: |
        # Workspace Guidelines
        - Keep state under /workspace so it survives suspend and resume.
    - path: "hello.sh"
      content: |
        #!/bin/sh
        echo "booted task in $(pwd) with DEMO_ENV=$DEMO_ENV" >> /workspace/run.log
---
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  name: demo-task
  atespace: ax-workshop
spec:
  image: "${RUNNER_IMAGE}"
  command: ["/bin/sh", "hello.sh"]
  debug: true
  workspaces:
    - name: demo-workspace
      path: "/workspace"
  env:
    - name: DEMO_ENV
      value: "workshop"
