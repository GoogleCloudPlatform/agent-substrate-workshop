# WorkerPool agents-vm (optional lab H): one microVM worker on the tainted nested-virt node pool.
# Same shape as Module 2's `agents` pool, plus sandboxClass, the node pool's label, and a toleration for
# its taint. MICROVM_WORKER_IMAGE comes from your shell (step 3 builds it); the gVisor WORKER_IMAGE can't
# run microVMs.
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: agents-vm
  namespace: ${NAMESPACE}
  labels:
    workload: workshop-agent-vm
spec:
  replicas: 1
  sandboxClass: microvm
  workerImage: ${MICROVM_WORKER_IMAGE}
  template:
    labels:
      workload: workshop-agent-vm
    nodeSelector:
      ate.dev/substrate-version: "${SUBSTRATE_VERSION}"
      workshop-pool: microvm
    tolerations:
    - {key: workshop-pool, operator: Equal, value: microvm, effect: NoSchedule}
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
