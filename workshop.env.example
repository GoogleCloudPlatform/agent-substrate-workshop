# Copy to workshop.env and fill in PROJECT_ID and CLUSTER_LOCATION. Everything else has a working default.
PROJECT_ID=
REGION=us-central1
CLUSTER_NAME=ate-cluster
# Your cluster's zone or region: the LOCATION column of `gcloud container clusters list`. A zonal cluster
# (e.g. us-central1-a) is not found under its region, so there is no default.
CLUSTER_LOCATION=
BUCKET_NAME=${PROJECT_ID}-ate
AR_REPO=workshop
KO_DOCKER_REPO=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}
# Platform(s) ko and docker buildx build for: your cluster's nodes, not your laptop. linux/arm64 for an Arm
# node pool; a comma-separated list builds each (and takes that much longer).
KO_DEFAULTPLATFORMS=linux/amd64

# Substrate version. Pin a tag or SHA; the instructor runbook says which one was validated.
SUBSTRATE_REF=v1.0.0-rc.1
# Set both (e.g. ghcr.io/agent-substrate/substrate and v1.0.0-rc.1) to install published images instead of building substrate from source.
SUBSTRATE_IMAGE_REPO=
SUBSTRATE_IMAGE_TAG=

# Workshop names
NAMESPACE=workshop
ATESPACE=workshop

# LLM: true forces the mock model; false calls Gemini on the Gemini Enterprise Agent Platform through Workload Identity.
MOCK_LLM=false
GEMINI_MODEL=gemini-3.8-flash
# Where model requests go. global is the platform's global endpoint. It's separate from REGION on purpose:
# the model's location doesn't have to match where your bucket and registry live.
MODEL_LOCATION=global

# Prometheus UI image (GMP frontend). Task 1 Step 8 records the current tag.
PROM_FRONTEND_IMAGE=gke.gcr.io/prometheus-engine/frontend:v0.15.3-gke.0
