# Copy to workshop.env and fill in PROJECT_ID. Everything else has a working default.
PROJECT_ID=
REGION=us-central1
CLUSTER_NAME=ate-cluster
CLUSTER_LOCATION=${REGION}   # the cluster's zone or region, as in `gcloud container clusters list`
BUCKET_NAME=${PROJECT_ID}-ate
AR_REPO=workshop
KO_DOCKER_REPO=${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}

# Substrate version. Pin a tag or SHA; the instructor runbook says which one was validated.
SUBSTRATE_REF=v0.2.0
# Set both to install published images instead of building substrate from source.
SUBSTRATE_IMAGE_REPO=
SUBSTRATE_IMAGE_TAG=

# Workshop names
NAMESPACE=workshop
ATESPACE=workshop

# LLM: true forces the mock model; false uses Vertex Gemini through Workload Identity.
MOCK_LLM=false
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=${REGION}

# Prometheus UI image (GMP frontend). Task 1 Step 8 records the current tag.
PROM_FRONTEND_IMAGE=gke.gcr.io/prometheus-engine/frontend:v0.15.3-gke.0
