# ActorTemplate sre-agent-v2 (ateapipb.ActorTemplate protojson schema).
# Applied with `kubectl ate create actor-template -f -`.
metadata:
  atespace: ${ATESPACE}
  name: sre-agent-v2
workerSelector:
  matchLabels:
    workload: sre-agent
containers:
  - name: agent
    image: ${AGENT_IMAGE}
    command: ["/ko-app/agent"]
    env:
      - name: PORT
        value: "80"
      - name: WORKSPACE_DIR
        value: "/workspace"
      - name: ACTOR_TEMPLATE
        value: "sre-agent-v2"
      - name: BROKER_URL
        value: "http://sre-gateway.${NAMESPACE}.svc.cluster.local:8080"
      - name: GEMINI_MODEL
        value: "${GEMINI_MODEL}"
    wakeupProbe:
      httpGet:
        path: /readyz
        port: 80
    securityContext:
      capabilities:
        add: ["NET_BIND_SERVICE"]
    volumeMounts:
      - name: workspace
        mountPath: /workspace
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 805306368
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
volumes:
  - name: workspace
    durableDir: {}
